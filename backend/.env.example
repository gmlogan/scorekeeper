NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost

# Password reset email (Brevo). Leave BREVO_API_KEY unset to stub sending
# (logs the reset link to the console instead) — useful until the sending
# domain's SPF/DKIM/DMARC is verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Set to "true" to log every outgoing email's to/from/subject/body to the
# console (stub or live). Off by default. Toggle + restart the container.
EMAIL_LOG_ENABLED=
