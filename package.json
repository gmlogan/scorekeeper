{
  "name": "scorekeeper",
  "version": "1.0.0",
  "description": "Real-time multiplayer score-tracking PWA",
  "main": "backend/src/server.js",
  "scripts": {
    "setup": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend:only": "cd backend && npm run dev",
    "dev:frontend:only": "cd frontend && npm run dev",
    "init": "cd backend && npm run init-db",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "cd backend && npm install --production",
    "build:frontend": "cd frontend && npm install && npm run build",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "NODE_ENV=test vitest run tests/api",
    "test:e2e": "playwright test",
    "start": "node backend/src/server.js",
    "docker:build": "docker build -t scorekeeper .",
    "docker:run": "docker run -p 5000:5000 scorekeeper"
  },
  "keywords": [
    "scorekeeper",
    "scoreboard",
    "game",
    "pwa",
    "react",
    "node"
  ],
  "author": "Graham",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^8.2.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
